---
const { project } = Astro.props;
---
<article class="work-row">
  <div class="work-year" aria-label={`Year ${project.year}`}>{project.year}</div>
  <div class="work-content">
    <div class="work-heading">
      <div>
        <p class="work-kicker">{project.type}</p>
        <h3>{project.title}</h3>
        <p class="work-subtitle">{project.subtitle}</p>
      </div>
      <span class="work-arrow" aria-hidden="true">↗</span>
    </div>
    <p class="work-excerpt">{project.excerpt}</p>
    <a class="text-link" href={`/projects/${project.slug}/`}>Learn more <span aria-hidden="true">→</span></a>
  </div>
</article>
