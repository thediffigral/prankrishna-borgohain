---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Prankrishna Borgohain`} description={project.excerpt}>
  <Header />
  <main class="project-page">
    <a class="back" href="/#projects">← All works</a>
    <p class="project-year">{project.year}</p>
    <h1>{project.title}</h1>
    <p class="project-subtitle">{project.subtitle}</p>
    <div class="project-meta"><span>{project.type}</span></div>
    <div class="project-intro">{project.excerpt}</div>

    <section class="project-copy">
      <h2>About</h2>
      <p>{project.description}</p>
    </section>
    <section class="project-copy">
      <h2>My role</h2>
      <p>{project.role}</p>
    </section>
    <section class="project-copy">
      <h2>People</h2>
      <p>{project.collaborators}</p>
    </section>
    <section class="project-copy project-media-note">
      <h2>Media</h2>
      <p>Images, videos, links and other material can be added here as the project archive develops.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
