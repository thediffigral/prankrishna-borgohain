---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Your Name`} description={project.excerpt}>
  <Header />
  <main class="project-page">
    <a class="back" href="/#projects">← All projects</a>
    <h1>{project.title}</h1>
    <div class="project-meta"><span>{project.year}</span><span>{project.type}</span></div>
    <div class="project-intro">{project.excerpt}</div>

    <section class="project-copy">
      <h2>About</h2>
      <p>{project.description}</p>
    </section>
    <section class="project-copy">
      <h2>My role</h2>
      <p>{project.role}</p>
    </section>
    <section class="project-copy">
      <h2>Media</h2>
      <p>Add images, film links, documents, credits or other material here as the project pages develop.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
