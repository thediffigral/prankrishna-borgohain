---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
import '../styles/global.css';
---
<BaseLayout title="Prankrishna Borgohain" description="A collection of projects by Prankrishna Borgohain.">
  <Header />
  <main>
    <section class="hero">
      <div class="eyebrow">Personal archive</div>
      <h1>What is your entropy?</h1>
      <p>I was asked for the past tense of think. I thought a lot and ended up answering thinked. </p>
    </section>

    <section class="section works" id="projects">
      {/* <div class="section-label">Works</div> */}
      <div class="work-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="section about" id="about">
      <div class="section-label">About</div>
      <div>
        <p> A Simple Person. </p>
        <div class="writings">
          <div>
            <h2>Epitaph - My Blog</h2>
            <p>Things I've written before I start to forget</p>
          </div>
          <a class="button" href="https://prankrishnab.blogspot.com" target="_blank" rel="noreferrer">Visit ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
