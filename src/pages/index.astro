---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
import '../styles/global.css';
---
<BaseLayout title="Prankrishna Borgohain — Works" description="A collection of projects by Prankrishna Borgohain.">
  <Header />
  <main>
    <section class="hero">
      <div class="eyebrow">Personal archive</div>
      <h1>Things I've made along the way.</h1>
      <p>A collection of ideas, experiments and collaborations that somehow became real.</p>
    </section>

    <section class="section works" id="projects">
      <div class="section-label">Works</div>
      <div class="work-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="section about" id="about">
      <div class="section-label">About</div>
      <div>
        <p>I like making things that begin as ideas and become something other people can experience — magazines, music, digital projects, comics, games and films.</p>
        <div class="writings">
          <div>
            <h2>My writings</h2>
            <p>Essays, notes and other things I've written.</p>
          </div>
          <a class="button" href="https://example.com/writings" target="_blank" rel="noreferrer">Visit ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
